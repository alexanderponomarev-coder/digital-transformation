# /etc/stratum/stratum.env
STRATUM_CORS_ORIGINS=*
# При отдельном фронте укажите origin явно:
# STRATUM_CORS_ORIGINS=https://stratum.example.com

# Порты (cohost с Klaris / 2fromlarec → 8080 / 8001)
STRATUM_HTTP_PORT=80
STRATUM_API_PORT=8000
# STRATUM_HTTP_PORT=8080
# STRATUM_API_PORT=8001

# --- Автообновление с GitHub ---
# Каталог с git clone репозитория (должен содержать .git)
STRATUM_GIT_DIR=/opt/stratum-src
STRATUM_GIT_REMOTE=origin
STRATUM_GIT_BRANCH=main
STRATUM_AUTO_UPDATE=1

# Опционально: webhook (sudo bash deploy/debian/enable-auto-update.sh --webhook)
# STRATUM_WEBHOOK_SECRET=change-me
# STRATUM_WEBHOOK_PORT=9000
