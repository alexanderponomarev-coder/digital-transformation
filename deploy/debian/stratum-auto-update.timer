[Unit]
Description=Timer: STRATUM auto-update from GitHub
Documentation=file:///opt/stratum/docs/DEPLOY_DEBIAN.md

[Timer]
# polling backup: каждые 2 минуты (мгновенно — GitHub webhook на push в main)
OnBootSec=1min
OnUnitActiveSec=2min
RandomizedDelaySec=20s
AccuracySec=30s
Persistent=true
Unit=stratum-auto-update.service

[Install]
WantedBy=timers.target
