# Публичный HTTP-порт на VPS (по умолчанию 80)
STRATUM_HTTP_PORT=80

# CORS: при same-origin через nginx достаточно "*", либо явный origin
# Пример: https://stratum.example.com,http://YOUR_VPS_IP
STRATUM_CORS_ORIGINS=*

# Режим: lab (default) | demo — см. docs/P4_STAND.md
# STRATUM_DEPLOY_MODE=lab
# API auth (пусто = открытый lab; на demo/VPS задайте токен)
# STRATUM_API_TOKEN=change-me
# STRATUM_DISABLE_RESET=1
# Frontend (сборка / sessionStorage):
# VITE_STRATUM_API_TOKEN=change-me
# VITE_STRATUM_USER=operator
