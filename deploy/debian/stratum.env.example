# /etc/stratum/stratum.env
STRATUM_CORS_ORIGINS=*
# Публичный URL (для CORS при явном списке):
# STRATUM_CORS_ORIGINS=https://stratum.example.com

# --- Режим стенда (P4) ---
# lab = продукт-лаборатория (локалка); demo = shared-стенд (1-web.ru и т.п.)
STRATUM_DEPLOY_MODE=lab
# STRATUM_DEPLOY_MODE=demo

# --- Доступ API (P0) ---
# Если задан — все /api/* кроме /api/health требуют: Authorization: Bearer …
# STRATUM_API_TOKEN=change-me-long-random
# На shared/demo стенде запретить сброс демо-данных:
STRATUM_DISABLE_RESET=1
# UI: sessionStorage.setItem('STRATUM_API_TOKEN', '…'); sessionStorage.setItem('STRATUM_USER', 'alice')

# Доменное имя (nginx server_name). На одном VPS с Klaris — разные домены, оба на :80.
# STRATUM_SERVER_NAME=stratum.example.com
STRATUM_SERVER_NAME=_

# Порты: HTTP обычно 80; API localhost (8001 если рядом Klaris на 8000)
STRATUM_HTTP_PORT=80
STRATUM_API_PORT=8000
# STRATUM_API_PORT=8001

# --- Автообновление с GitHub (push в main + timer) ---
# Включение: sudo bash /opt/stratum/deploy/debian/enable-auto-update.sh
# Статус:    sudo bash /opt/stratum/deploy/debian/auto-update-status.sh
STRATUM_GIT_DIR=/opt/stratum-src
STRATUM_GIT_REMOTE=origin
STRATUM_GIT_BRANCH=main
STRATUM_AUTO_UPDATE=1
# Публичный URL remote (токен НЕ пишите сюда — только в STRATUM_GITHUB_TOKEN):
STRATUM_REPO_URL=https://github.com/alexanderponomarev-coder/digital-transformation-.git

# Private GitHub: fine-grained PAT (Contents: Read) или classic с repo.
# Используется при git clone (если /opt/stratum-src нет) и при fetch — в .git/config не пишется.
# STRATUM_GITHUB_TOKEN=ghp_xxx

# Webhook: sudo bash deploy/debian/enable-auto-update.sh --webhook
# URL: https://stratum.example.com/hooks/github
# STRATUM_WEBHOOK_SECRET=change-me
# STRATUM_WEBHOOK_PORT=9000
